{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src"],
  "exclude": ["src/collector", "src/analysis", "src/refresh", "src/vision", "src/insight", "src/history", "src/radar", "src/productDates/loadEnrichment.ts", "src/taxonomy/vision/runPilot.ts", "src/taxonomy/vision/analyzeFamilyLive.ts", "src/modelFamily/dataset.ts", "src/modelFamily/__tests__/dataset.test.ts"]
}
